+// Skate 3 Native additions.
+
+inline simde__m128i simde_mm_cmpgt_epu32(simde__m128i a, simde__m128i b)
+{
+    simde__m128i c = simde_mm_set1_epi32(INT_MIN);
+    return simde_mm_cmpgt_epi32(simde_mm_xor_si128(a, c), simde_mm_xor_si128(b, c));
+}
+
+// vsl: shift the whole 128-bit register left by 0-7 bits. The vector is stored byte-reversed,
+// so the host's little-endian 128-bit value equals the guest's big-endian one. Element 2 needs
+// the bits that cross the 64-bit lane boundary, taken from a copy shifted up by one element.
+inline simde__m128i simde_mm_vsl(simde__m128i a, simde__m128i b)
+{
+    b = simde_mm_srli_epi64(simde_mm_slli_epi64(b, 61), 61);
+    return simde_mm_castps_si128(simde_mm_insert_ps(simde_mm_castsi128_ps(simde_mm_sll_epi64(a, b)), simde_mm_castsi128_ps(simde_mm_sll_epi64(simde_mm_slli_si128(a, 4), b)), 0xE0));
+}
+
+// vctuxs / vcfpuxws128: float to unsigned word, saturating. NaN and negatives give 0,
+// values of 2^32 and up give 0xFFFFFFFF, everything else truncates toward zero.
+inline simde__m128i simde_mm_vctuxs(simde__m128 src)
+{
+    simde__m128 clamped = simde_mm_max_ps(src, simde_mm_setzero_ps()); // maxps returns 0 for NaN
+    simde__m128 two31 = simde_mm_set1_ps(2147483648.0f);
+    simde__m128i low = simde_mm_cvttps_epi32(clamped);
+    simde__m128i high = simde_mm_add_epi32(simde_mm_cvttps_epi32(simde_mm_sub_ps(clamped, two31)), simde_mm_set1_epi32(INT_MIN));
+    simde__m128i value = simde_mm_blendv_epi8(low, high, simde_mm_castps_si128(simde_mm_cmpge_ps(clamped, two31)));
