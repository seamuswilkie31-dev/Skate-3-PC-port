+// Xbox 360 half floats (VMX128 D3D packs, Xenos vertex formats) have no INF or NaN:
+// exponent 31 is an ordinary exponent. Packing truncates toward zero; NaN and magnitudes
+// above 65504 saturate to 0x7FFF with the sign kept (as XenonRecomp's float16_4 pack did).
+inline uint16_t ppc_pack_half(uint32_t bits)
+{
+    uint32_t sign = (bits >> 16) & 0x8000;
+    uint32_t magnitude = bits & 0x7FFFFFFF;
+    float value = __builtin_bit_cast(float, magnitude);
+    if (value != value || value > 65504.0f)
+        return uint16_t(sign | 0x7FFF);
+
+    uint32_t exponent = magnitude >> 23;
+    uint32_t mantissa = (magnitude >> 13) & 0x3FF;
+    if (exponent > 112)
+        return uint16_t(sign | ((exponent - 112) << 10) | mantissa);
+
+    // Below 2^-14 the result is a half denormal: shift the implicit 1 down.
+    uint32_t shift = 113 - exponent;
+    return uint16_t(sign | (shift > 31 ? 0 : (0x400 | mantissa) >> shift));
+}
+
+inline float ppc_unpack_half(uint16_t half)
+{
+    uint32_t sign = uint32_t(half & 0x8000) << 16;
+    int32_t exponent = (half >> 10) & 0x1F;
+    uint32_t mantissa = half & 0x3FF;
+    if (exponent == 0)
+    {
+        if (mantissa == 0)
+            return __builtin_bit_cast(float, sign);
+
+        // Half denormals are normal floats: renormalize.
+        exponent = 1;
+        while (!(mantissa & 0x400))
+        {
+            mantissa <<= 1;
+            --exponent;
+        }
+        mantissa &= 0x3FF;
+    }
+    return __builtin_bit_cast(float, sign | (uint32_t(exponent + 112) << 23) | (mantissa << 13));
+}
+
